# Environment variables for smol news agent

# Azure AI Foundry configuration (OpenAI or Anthropic endpoint)
AZURE_AI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/gpt-4.1/chat/completions?api-version=2024-05-01-preview
AZURE_AI_API_KEY=your-api-key-here
AZURE_AI_MODEL=gpt-4.1

# Teams webhook (from your private channel)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/WEBHOOK/URL

# Schedule (cron format: "35 8 * * 1-5" = Mon-Fri 8:35am)
DIGEST_SCHEDULE=35 8 * * 1-5

# Optional: Override news source
NEWS_SOURCE_URL=https://news.smol.ai/

# State file location (tracks last processed date)
STATE_FILE=./.state.json
